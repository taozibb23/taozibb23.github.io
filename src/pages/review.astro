---
import Base from '../layouts/Base.astro';

const topics = [
  { icon:'C++', title:'C++ 与工程接口', text:'指针、构造与封装、回调、固定尺寸矩阵、包与模块边界。', links:[['/blog/13-cpp-ctor-init-list/','构造与初始化'],['/blog/15-cpp-project-encapsulation/','封装']] },
  { icon:'ROS', title:'ROS2 与系统边界', text:'节点、消息、依赖、跨包契约，以及“接口通过”不等于整链路通过。', links:[['/blog/03-yolo-armor-ros2/','ROS2 链路'],['/blog/20-worldsnapshot-and-vision-boundary/','边界']] },
  { icon:'CAM', title:'相机、标定与手眼', text:'内参、畸变、重投影误差、采集覆盖；手眼仍按真实姿态与留出样本验收。', links:[['/blog/04-camera-calibration/','相机标定'],['#camera','真实相机案例']] },
  { icon:'PnP', title:'PnP 与坐标系', text:'像素角点到三维位姿、物理点定义、坐标链和单位；小重投影误差不保证物理点正确。', links:[['/projects/rm-armor-vision/','PnP 项目'],['#simulation','仿真诊断']] },
  { icon:'DET', title:'Detector 与角点', text:'8400 输出解码、NMS、重复/漏板、类别与角点物理定义。', links:[['/blog/01-8400-cards-to-box/','输出解码'],['/blog/06-nms-clusters-geometry/','NMS']] },
  { icon:'EKF', title:'EKF、关联与 NIS', text:'状态、预测、更新、协方差与认板；NIS 是 PR #5 合入时版本的历史验证，不能直接代表当前分支。', links:[['/blog/19-ekf-association-and-nis/','关联与 NIS'],['#ekf','PR #5 案例']] },
  { icon:'IO', title:'通信与 RoboLink', text:'字节序、帧、CRC、资源生命周期，以及接收、执行、反馈三个不同验收层。', links:[['/blog/22-robolink-bytes-and-boundaries/','协议字节'],['#usb','USB CDC 案例']] },
  { icon:'LAB', title:'调试与对照实验', text:'把观感拆成可复现问题，一次改变一个变量，保留失败样本和验证边界。', links:[['#simulation','2400 帧诊断'],['#camera','标定排错']] }
];

const cases = [
  {
    id: 'camera', level: 'camera', eyebrow: '案例 01 · 个人项目 · 真实相机',
    title: '奥尼 C33：先排查采集链路，再谈标定结果',
    ownership: '本人负责采集棋盘格、固定变量、补足画面覆盖、识别异常样本并做实验取舍；标定工具主体由 AI 辅助生成，不写成本人独立实现标定算法。项目于 2026-09-28 左右收尾。',
    steps: ['第一次重投影误差约 2.96 px。检查后发现纸张可能弯曲、左侧画面覆盖不足，并定位到一张单图误差异常。','固定棋盘格、补足覆盖、剔除异常图像并复测，重投影误差降到约 0.483 px。','ROS2 采集节点曾约 2.8 FPS；逐项排除日志、分辨率/格式和 USB 口后，定位瓶颈在相机读取，640×480 MJPG 由约 4 FPS 调到 15 FPS。'],
    boundary: '个人真实相机。重投影误差不是三维定位精度；结果不能外推到战队海康相机、今年装甲特征或整条检测—控制链路。',
    pitch: '我用覆盖、姿态和异常样本做控制变量，把标定重投影误差从 2.96 px 降到 0.483 px，并通过分段排查确认采集帧率瓶颈在相机读取。',
    questions: ['为什么重投影误差下降不等于 PnP 三维精度提高？','怎样区分采集数据问题与标定模型问题？','为什么换 MJPG 和 USB 口属于定位实验？'],
    links: [['/blog/04-camera-calibration/','标定复盘'],['/projects/rm-armor-vision/','项目详情'],['https://github.com/taozibb23/rm-armor-vision','GitHub']]
  },
  {
    id: 'ekf', level: 'synthetic', eyebrow: '案例 02 · 战队 PR · 合成单测',
    title: 'PR #5：把“滤波器能跑”拆成关联、更新和统计验收',
    ownership: '本人提交的 foray_auto_aim PR #1–#5 均合入 dev；具体文件有 AI/协作参与，不等于五个模块全部独立手写。PR #5 的公开描述与测试结果可追溯。',
    steps: ['问题不是只让 EKF 输出数字，而是错误关联会把错误新息送入状态估计；关联失败时需要拒绝更新。','PR 合入时记录 17 条 gtest 通过；合成 1 m/s 匀速目标速度 RMSE 为 0.0305 m/s。','四板轮换合成场景的车心位置 RMSE 为 0.00694 m，并用 NIS 排除统计异常观测。'],
    boundary: '合成单测、PR 合入时版本。当前工作分支的 target.cpp 未保留当时的 NIS 门限，不能把历史 17 条测试和指标当作当前代码的统一验收；也不是实车跟踪或命中率。',
    pitch: '我把状态估计验收拆成关联拒绝、更新路径和可复算指标，在合成场景中验证速度与车心估计，而没有把单测包装成实机效果。',
    questions: ['为什么有 NIS 仍需要前置关联门限？','关联失败时为何应跳过更新？','RMSE 的对象、真值和有效帧应该怎样说明？'],
    links: [['https://github.com/ZQU-Foray/foray_auto_aim/pull/5','PR #5'],['/blog/19-ekf-association-and-nis/','关联与 NIS'],['/projects/foray-team/','战队项目页']]
  },
  {
    id: 'simulation', level: 'simulation', eyebrow: '案例 03 · 旧模型诊断 · 仿真/离线回放',
    title: '“白框还是会偏移”：把前端偏差和 Tracker 问题分开',
    ownership: '本人提出“白框还是会偏移”和分档采样要求；适配器、批量运行和部分统计由 AI 辅助。SP、奇点曾作为开源机制对照；现在 AutoAim 在 Foray 基线上加入可选的 SP 近三候选关联策略，不等于迁入整个 SP 后端。',
    steps: ['先用同一 PnP 比较旧模型候选与理想角点：静止仿真中板位置相差约 0.1277 m，即使候选重投影误差仍小于 0.1 px。','再对 2/4/5/10 rad/s 各采集旧模型与理想输入 300 帧，共 2400 帧。理想输入可稳定跟踪，旧模型组车心平均 XY 误差约 0.49–0.62 m。','同观测 4 rad/s、300 帧对照：SP / Foray 的车心平均误差为 0.256 / 0.127 m，单帧超过 0.20 m 的跳变为 2 / 13 次；Foray 均值更准但跳动更多。由此分别追查前端系统偏差与后端关联平滑性。'],
    boundary: '仿真/离线诊断，使用旧赛季模型；2400 帧的旧模型组与理想组不是严格同帧 A/B。SP / Foray 同观测对照不代表实机命中。可选 SP 策略在另一随机序列的跳变数字不能与这里的 13 次直接相减，不能声称因果改善。',
    pitch: '我用理想输入作后端对照，再按四档转速保存 2400 帧日志，确认主要误差在 EKF 之前，并把重复候选、关联和高度不可观测拆开验证。',
    questions: ['为什么小重投影误差不能证明角点物理定义正确？','理想输入稳定能证明什么，又不能证明什么？','为什么不能直接放宽关联门限吞下偏差观测？'],
    links: [['/blog/20-worldsnapshot-and-vision-boundary/','接口与边界'],['https://github.com/TongjiSuperPower/sp_vision_25','SP 对照来源'],['https://github.com/NOMANE-0/QD_Vision2026','奇点对照来源']]
  },
  {
    id: 'usb', level: 'synthetic', eyebrow: '案例 04 · 平台接口 · 软件/无硬件测试',
    title: 'Vision 与 USB CDC：先把“测试通过”的边界写清楚',
    ownership: '本人参与模块建设和接口理解；USB CDC 的资源管理代码由本人编写，测试补充、构建配置和候选协议解读有 AI 辅助。候选协议不是本人独立完成的完整通信链路。',
    steps: ['Vision 曾记录 10 个合成/单元测试、0 失败；USB CDC 曾记录 4 个无硬件测试、0 失败。它们来自不同时间的日志，不能相加成一次完整测试。','USB CDC 覆盖缺少设备、打开/关闭/重开、未打开读取和读取容量等资源管理路径。','RoboLink 后来做过主控只收数的短测；收发对账、控制执行、图像与姿态同步和云台动作仍需分别验收。'],
    boundary: '软件/合成与无硬件测试。CRC 通过只证明字节未被检测到损坏，不证明 MCU 接受、执行或云台完成动作。',
    pitch: '我把“通过测试”拆成输入、失败路径和验证级别，先证明资源管理与接口契约，再把真机通信和执行反馈列为独立验收。',
    questions: ['CRC 通过为什么不等于命令被执行？','哪些路径只能接真实设备后验证？','怎样区分本人代码、AI 辅助测试与开源协议参考？'],
    links: [['/blog/21-vision-evidence-and-usb-cdc/','Vision/USB CDC'],['/blog/22-robolink-bytes-and-boundaries/','RoboLink 复盘'],['https://github.com/ZQU-Foray/foray_platform','foray_platform']]
  }
];
---

<Base title="学习复盘与关键词" description="按 C++、ROS2、标定、PnP、Detector、EKF、通信与实验方法复习，并用真实案例核对证据边界。">
  <section class="page-head container-prose review-hero" data-reveal="focus">
    <p class="eyebrow">REVIEW LAB · 从关键词回到原理和亲手做过的实验</p>
    <h1><span class="grad">学习复盘与关键词</span></h1>
    <p class="desc">不要求每篇学习记录都属于某个项目。可以先按 PnP、EKF、Detector、通信等关键词复习概念，再回到“问题 → 证据 → 取舍 → 边界”的真实案例。</p>
    <div class="review-stats" aria-label="复习栏目概览">
      <div><strong>分层</strong><span>按证据等级复盘</span></div>
      <div><strong>8</strong><span>关键词学习入口</span></div>
      <div><strong>4</strong><span>证据复盘案例</span></div>
    </div>
  </section>

  <section class="container review-topics" data-reveal>
    <div class="container-prose topic-heading"><p class="eyebrow">关键词地图</p><h2>今天想复习什么？</h2><p>先选知识点，不必记得它属于哪个项目。</p></div>
    <div class="topic-grid">
      {topics.map((topic) => (
        <article class="topic-card">
          <span class="topic-icon">{topic.icon}</span><h3>{topic.title}</h3><p>{topic.text}</p>
          <div>{topic.links.map(([href,label]) => <a href={href}>{label}<span aria-hidden="true"> ›</span></a>)}</div>
        </article>
      ))}
    </div>
  </section>

  <section class="container-prose review-map" data-reveal>
    <h2>先看证据等级</h2>
    <div class="evidence-ladder">
      <div><span>01</span><strong>合成/软件测试</strong><small>证明接口、算法路径或失败处理</small></div>
      <div><span>02</span><strong>仿真/离线回放</strong><small>证明特定场景下的诊断与对照</small></div>
      <div><span>03</span><strong>真实相机</strong><small>证明采集、标定或真实图像链路</small></div>
      <div class="pending"><span>→</span><strong>仍待验收</strong><small>手眼外参、云台执行、闭环与命中实验</small></div>
    </div>
  </section>

  <section class="container-prose review-browser" data-reveal>
    <div class="review-toolbar">
      <div><p class="eyebrow">复习卡片</p><h2>按证据类型筛选</h2></div>
      <div class="review-filters" role="group" aria-label="筛选复习卡">
        <button class="active" type="button" data-filter="all">全部</button>
        <button type="button" data-filter="camera">真实相机</button>
        <button type="button" data-filter="synthetic">合成/软件</button>
        <button type="button" data-filter="simulation">仿真</button>
      </div>
    </div>
    <div class="review-list">
      {cases.map((item) => (
        <article class="review-card" data-review-card data-level={item.level} id={item.id}>
          <p class="eyebrow">{item.eyebrow}</p><h2>{item.title}</h2>
          <details open><summary>项目与贡献归属</summary><p>{item.ownership}</p></details>
          <details><summary>关键错误 → 证据 → 修复/取舍</summary><ol>{item.steps.map((step) => <li>{step}</li>)}</ol></details>
          <div class="boundary"><strong>验证边界</strong><p>{item.boundary}</p></div>
          <blockquote><strong>面试一句话</strong><br />{item.pitch}</blockquote>
          <details class="quiz"><summary>展开 3 个自测题</summary><ol>{item.questions.map((question) => <li>{question}</li>)}</ol></details>
          <p class="source-links"><strong>原始链接：</strong>{item.links.map(([href,label], index) => (<><a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener' : undefined}>{label}</a>{index < item.links.length - 1 && <span> · </span>}</>))}</p>
        </article>
      ))}
    </div>
    <p class="review-empty" hidden data-review-empty>这个筛选下暂时没有已核对案例。</p>
  </section>

  <section class="container-prose pending-board" data-reveal>
    <p class="eyebrow">正在学习，不提前写成成果</p><h2>下一批复盘入口</h2>
    <ul>
      <li><strong>双 Detector / 新赛季模型：</strong>正式 process_armor_frame() 已连到 PnP，位于已推送的功能分支；真实图像的类别、角点、耗时与失败样本仍待验收，夹具测试跳过不算通过。</li>
      <li><strong>本队海康手眼：</strong>真实采集 61 张，38 组拟合、11 组留出；留出一致性平均误差约 29.1 mm / 2.36°。候选外参暂不能用于控制，需继续排查同步与姿态质量。</li>
      <li><strong>RoboLink 与云台：</strong>已有主控只收数短测；发包对账、云台执行和图像—姿态同步仍是不同等级，不能互相替代。</li>
    </ul>
  </section>

  <script>
    function bindReviewFilters() {
      const buttons = Array.from(document.querySelectorAll('[data-filter]'));
      const cards = Array.from(document.querySelectorAll('[data-review-card]'));
      const empty = document.querySelector('[data-review-empty]');
      if (!buttons.length || !cards.length) return;
      for (const button of buttons) {
        if (button.dataset.bound) continue;
        button.dataset.bound = '1';
        button.addEventListener('click', () => {
          const filter = button.dataset.filter;
          let visible = 0;
          for (const other of buttons) other.classList.toggle('active', other === button);
          for (const card of cards) {
            const show = filter === 'all' || card.dataset.level === filter;
            card.hidden = !show;
            if (show) visible += 1;
          }
          if (empty) empty.hidden = visible !== 0;
        });
      }
    }
    document.addEventListener('astro:page-load', bindReviewFilters);
    bindReviewFilters();
  </script>
</Base>
