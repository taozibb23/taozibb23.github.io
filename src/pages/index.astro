---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../config';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base>
  <section class="hero">
    <div class="container hero-inner" data-reveal-group>
    <p class="eyebrow">ROBOT VISION / 感知 / 部署</p>
    <h1>你好，我是 {SITE.author}。</h1>
    <p class="lead">
      {SITE.intro}
    </p>

    <div class="hero-cta">
      <a class="btn-primary" href="/projects/">查看项目</a>
      <a class="link-more" href="/blog/">阅读博客 <span aria-hidden="true">›</span></a>
    </div>

    <div class="term">
      <div class="term-bar">
        <i></i><i></i><i></i>
        <span class="title">vision-pipeline — zsh</span>
      </div>
      <div class="term-body">
        <div><span class="p">$</span> cat pipeline.md</div>
        <div>
          <span class="c"># 一条完整的视觉工程链路,每一环都亲手跑通并测过数据</span>
        </div>
        <div>
          YOLO26-pose 训练 <span class="c">→</span> ONNX 导出 <span class="c">→</span> C++ onnxruntime 推理
          <span class="c">→</span> ROS2 节点 <span class="c">→</span> 相机标定 <span class="c">→</span> PnP 测距
          <span class="c">→</span> 卡尔曼滤波<span class="cursor"></span>
        </div>
      </div>
    </div>

    <div class="cloud-row">
      <div class="metric">
        <span class="num">0.842</span>
        <span class="label">检测框 mAP50</span>
      </div>
      <div class="metric">
        <span class="num">0.48<small> px</small></span>
        <span class="label">标定误差(三批迭代)</span>
      </div>
      <div class="metric">
        <span class="num">≈1<small> mm</small></span>
        <span class="label">1 米定位精度(PnP)</span>
      </div>
      <div class="metric">
        <span class="num">36.8<small> FPS</small></span>
        <span class="label">CPU 推理帧率(实测)</span>
      </div>
    </div>
  </div>
  </section>

  <section class="band band--gray" transition:name="blog-stage">
    <div class="container">
    <div class="section-head" data-reveal="focus">
      <p class="eyebrow">BLOG</p>
      <h2><span class="grad">最新文章</span></h2>
      <a class="more" href="/blog/">全部 {posts.length} 篇 <span aria-hidden="true">›</span></a>
    </div>
    </div>
    <div class="scroller" data-scroller>
      <div class="scroller-track">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
    <div class="scroller-nav container">
      <button class="scroller-btn" data-sc-prev aria-label="上一张">‹</button>
      <button class="scroller-btn" data-sc-next aria-label="下一张">›</button>
    </div>
  </section>

  <section class="band band--white" transition:name="projects-stage">
    <div class="container">
    <div class="section-head" data-reveal="focus">
      <p class="eyebrow">PROJECTS</p>
      <h2><span class="grad">项目</span></h2>
      <a class="more" href="/projects/">全部项目 <span aria-hidden="true">›</span></a>
    </div>
    <div class="proj-grid" data-reveal-group>
      <article class="proj-card" transition:name="proj-rmav">
        <p class="eyebrow">个人项目</p>
        <h3><a href="/projects/rm-armor-vision/">rm-armor-vision · 装甲板视觉识别全链路</a></h3>
        <p>
          从数据集到测距的完整链路:YOLO26-pose 从随机初始化训练 → ONNX 导出 → C++ 手写推理管线(letterbox / 8400 解码 / IoU / NMS)
          → ROS2 节点 → 相机标定 → PnP 单目测距。仓库含演示 GIF、训练曲线与构建说明。
        </p>
        <div class="metrics">
          <div class="metric"><span class="num">0.842</span><span class="label">框 mAP50</span></div>
          <div class="metric"><span class="num">0.675</span><span class="label">角点 mAP50</span></div>
          <div class="metric"><span class="num">0.48<small>px</small></span><span class="label">标定误差</span></div>
        </div>
        <div class="links">
          <a href="/projects/rm-armor-vision/">查看详情 <span aria-hidden="true">›</span></a>
          <a href="https://github.com/taozibb23/rm-armor-vision" target="_blank" rel="noopener">GitHub →</a>
        </div>
      </article>
      <article class="proj-card">
        <p class="eyebrow">团队 · RoboMaster 战队视觉</p>
        <h3>战队视觉模块 · 我负责的部分</h3>
        <p>
          暑假通过招新考核后正式入队:从零搭起 ROS2 包骨架(PR #1),之后装甲板检测接口、敌我三态识别、
          云台角解算防御、整车状态估计 EKF 逐个落进 foray_auto_aim;另参与 RoboLink 上下位机协议评审。
          全部代码公开,可直接查看:
        </p>
        <div class="metrics">
          <div class="metric"><span class="num">4</span><span class="label">PR 全部已合并</span></div>
          <div class="metric"><span class="num">14</span><span class="label">gtest 全绿</span></div>
        </div>
        <div class="links">
          <a href="https://github.com/ZQU-Foray/foray_vision" target="_blank" rel="noopener">foray_vision →</a>
          <a href="https://github.com/ZQU-Foray/foray_auto_aim" target="_blank" rel="noopener">foray_auto_aim →</a>
          <a href="https://github.com/ZQU-Foray/foray_interfaces" target="_blank" rel="noopener">foray_interfaces →</a>
        </div>
      </article>
    </div>
    </div>
  </section>

  <section class="band band--gray">
    <div class="container">
      <div class="section-head" data-reveal="focus">
        <p class="eyebrow">WORKBENCH</p>
        <h2><span class="grad">工作台</span></h2>
        <a class="more" href="/workbench/">进去看看 <span aria-hidden="true">›</span></a>
      </div>
      <div class="bench-strip" data-reveal-group>
        <a class="bench-mini" href="/workbench/">
          <img src="/images/workbench/cad-01.svg" alt="零件轮廓练习线稿" loading="lazy" />
          <div class="t">
            <strong>工程图练习</strong>
            <span>零件轮廓与三视图,从 DXF 矢量数据原样描线</span>
          </div>
        </a>
        <a class="bench-mini" href="/workbench/">
          <img src="/images/workbench/pcb2d-stm32.png" alt="STM32 开发板布线图缩略" loading="lazy" />
          <div class="t">
            <strong>画板与建模</strong>
            <span>方程式车架 3D(可点选杆件)· 蓝色板底 PCB 3D · 三块板从立创EDA 到 gerber</span>
          </div>
        </a>
      </div>
    </div>
  </section>
<script>
  // 画廊箭头:按卡宽步进滚动;端点自动禁用
  function bindScroller() {
    const sc = document.querySelector('[data-scroller]');
    if (!sc || sc.dataset.scBound) return;
    sc.dataset.scBound = '1';
    const track = sc.querySelector('.scroller-track');
    const prev = document.querySelector('[data-sc-prev]');
    const next = document.querySelector('[data-sc-next]');
    const step = () => {
      const card = track && track.querySelector('.post-card');
      if (!card) return 400;
      const gap = parseFloat(getComputedStyle(track).gap || '24') || 24;
      return card.getBoundingClientRect().width + gap;
    };
    prev?.addEventListener('click', () => sc.scrollBy({ left: -step(), behavior: 'smooth' }));
    next?.addEventListener('click', () => sc.scrollBy({ left: step(), behavior: 'smooth' }));
    const update = () => {
      const max = sc.scrollWidth - sc.clientWidth - 1;
      if (prev) prev.disabled = sc.scrollLeft <= 1;
      if (next) next.disabled = sc.scrollLeft >= max;
    };
    sc.addEventListener('scroll', update, { passive: true });
    update();

    // 鼠标拖动滑动(触屏走原生;拖后松手吸附最近卡,拖动过的点击不触发导航)
    let down = false, sx = 0, sl = 0, movedPx = 0;
    sc.addEventListener('dragstart', (e) => e.preventDefault());
    sc.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch') return;
      down = true; movedPx = 0;
      sx = e.clientX; sl = sc.scrollLeft;
      sc.style.scrollSnapType = 'none';
      sc.classList.add('dragging');
    });
    window.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - sx;
      movedPx = Math.max(movedPx, Math.abs(dx));
      sc.scrollLeft = sl - dx;
    });
    const settle = () => {
      if (!down) return;
      down = false;
      sc.classList.remove('dragging');
      const card = sc.querySelector('.post-card');
      const gap = parseFloat(getComputedStyle(sc.querySelector('.scroller-track')).gap || '24') || 24;
      const step = card ? card.getBoundingClientRect().width + gap : 400;
      const target = Math.round(sc.scrollLeft / step) * step;
      sc.scrollTo({ left: target, behavior: 'smooth' });
      setTimeout(() => { sc.style.scrollSnapType = ''; }, 500);
    };
    window.addEventListener('pointerup', settle);
    window.addEventListener('pointercancel', settle);
    sc.addEventListener(
      'click',
      (e) => {
        if (movedPx > 6) {
          e.preventDefault();
          e.stopPropagation();
          movedPx = 0;
        }
      },
      true
    );
  }
  bindScroller();
  document.addEventListener('astro:page-load', bindScroller);
</script>
</Base>
