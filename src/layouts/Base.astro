---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.title} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(currentPath, Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container inner">
        <a href="/" class="brand" aria-label="返回首页">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4.6 10.2 3.6 4.4l4.9 2.9" />
            <path d="M19.4 10.2 20.4 4.4l-4.9 2.9" />
            <ellipse cx="12" cy="13.4" rx="8.1" ry="6.3" />
            <circle cx="8.6" cy="13.2" r="0.75" fill="currentColor" stroke="none" />
            <circle cx="15.4" cy="13.2" r="0.75" fill="currentColor" stroke="none" />
            <ellipse cx="12" cy="15" rx="0.95" ry="0.6" fill="currentColor" stroke="none" />
            <path d="M1.2 12.2h2.6M1.7 14.9h2.3M22.8 12.2h-2.6M22.3 14.9h-2.3" stroke-width="1.2" />
            <circle cx="17.6" cy="7.1" r="1.35" fill="#e05d44" stroke="none" />
            <circle cx="20.6" cy="6.1" r="1.15" fill="#e05d44" stroke="none" />
            <circle cx="20.4" cy="8.5" r="1.15" fill="#e05d44" stroke="none" />
          </svg>
          <span class="brand-name">{SITE.author}</span>
        </a>
        <nav class="site-nav">
          <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>首页</a>
          <a href="/blog/" aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}>博客</a>
          <a href="/projects/" aria-current={currentPath.startsWith('/projects') ? 'page' : undefined}>项目</a>
          <a href="/about/" aria-current={currentPath.startsWith('/about') ? 'page' : undefined}>关于</a>
          <a href={SITE.social.github} target="_blank" rel="noopener" aria-label="GitHub" class="icon-btn" style="margin-left:.35rem">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .31.21.67.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container inner">
        <span>
          © {new Date().getFullYear()} {SITE.author} · 用 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 构建 ·
          托管于 <a href="https://pages.github.com" target="_blank" rel="noopener">GitHub Pages</a>
        </span>
        <span>
          <a href="/rss.xml">RSS</a> ·
          <a href={SITE.social.github} target="_blank" rel="noopener">GitHub</a> ·
          <a href={SITE.social.csdn} target="_blank" rel="noopener">CSDN</a>
          {SITE.social.email && <> · <a href={`mailto:${SITE.social.email}`}>邮箱</a></>}
        </span>
      </div>
    </footer>

    <script>
      // 浮现可双向重触发:进入视口 18% 加 .in,完全离开再移除(上下滚动都有转场)
      function bindReveals() {
        const ioIn = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) e.target.classList.add('in');
            }
          },
          { threshold: 0.18, rootMargin: '0px 0px -6% 0px' }
        );
        const ioOut = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) e.target.classList.remove('in');
          }
        });
        document.querySelectorAll('[data-reveal], [data-reveal-group]').forEach((el) => {
          if (el.dataset.revealBound) return;
          el.dataset.revealBound = '1';
          ioIn.observe(el);
          ioOut.observe(el);
        });
      }
      document.addEventListener('astro:page-load', bindReveals);
      // 首次加载:astro:page-load 可能在本模块执行前就已触发,直接补一次
      bindReveals();

      // 渲染探针:后台标签页/预渲染环境里 IO 不触发(渲染帧停止),
      // 只有确认渲染活跃才启用"隐藏待浮现"状态,内容绝不永久不可见
      const probe = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          document.documentElement.classList.add('io-ok');
          probe.disconnect();
        }
      });
      probe.observe(document.body);

      // 画廊居中强调的 JS 回退:Firefox/旧 Safari 无滚动驱动动画
      // (0s 定格末帧 = 整排淡框),按"与画廊中心距离"套用同一套阶梯
      function bindEmphasisFallback() {
        // 支持滚动驱动且未被手动禁用(sdt-off 测试钩子)→ 走原生,无需回退
        if ((!window.CSS || CSS.supports('animation-timeline: view()')) && !document.documentElement.classList.contains('sdt-off')) return;
        document.documentElement.classList.add('no-sdt');
        const sc = document.querySelector('[data-scroller]');
        if (!sc || sc.dataset.empBound) return;
        sc.dataset.empBound = '1';
        const apply = () => {
          // 注意:clientWidth 是元素属性,DOMRect 上不存在(这里曾踩 NaN 坑)
          const mid = sc.getBoundingClientRect().left + sc.clientWidth / 2;
          const half = sc.clientWidth / 2;
          for (const card of sc.querySelectorAll('.post-card')) {
            const r = card.getBoundingClientRect();
            const d = Math.min(Math.abs(r.x + r.width / 2 - mid) / (half + r.width / 2), 1);
            const dir = r.x + r.width / 2 < mid ? -1 : 1;
            card.style.opacity = (1 - 0.74 * d).toFixed(3);
            card.style.transform = `rotateY(${(dir * 24 * d).toFixed(1)}deg) scale(${(1.08 - 0.46 * d).toFixed(3)})`;
          }
        };
        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => { apply(); ticking = false; });
        };
        sc.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        window.__emphasisApply = apply;
        apply();
      }
      window.__bindEmphasis = bindEmphasisFallback;
      document.addEventListener('astro:page-load', () => bindEmphasisFallback());
      bindEmphasisFallback();
    </script>
  </body>
</html>
