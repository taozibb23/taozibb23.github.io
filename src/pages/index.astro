---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../config';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base>
  <section class="hero">
    <div class="container hero-inner" data-reveal-group>
    <p class="eyebrow">ROBOT VISION / 战队视觉项目负责人</p>
    <h1>你好，我是 {SITE.author}。</h1>
    <p class="lead">
      {SITE.intro}
    </p>

    <div class="hero-cta">
      <a class="btn-primary" href="/projects/">查看项目</a>
      <a class="link-more" href="/status/">当前进度 <span aria-hidden="true">›</span></a>
      <a class="link-more" href="/blog/">阅读博客 <span aria-hidden="true">›</span></a>
    </div>

    <p class="hero-evidence">项目整体由我负责推进；台架已有真实云台姿态响应，命中与机械臂实物抓取仍待验收。<a href="/status/">查看当前进度与实验数据 →</a></p>
  </div>
  </section>

  <section class="band band--gray">
    <div class="container">
      <div class="section-head" data-reveal="focus">
        <p class="eyebrow">PIPELINE · 视觉系统如何工作</p>
        <h2><span class="grad">从像素到毫米，必经五环</span></h2>
        <p class="sub">一帧装甲板观测，要走过这五环才变成云台响应——每一环我都独立验证、记录失败。</p>
      </div>
      <ol class="pipeline" data-reveal-group>
        <li class="step"><span class="step-num">01</span><h3>观测</h3><p>相机取流 · 双模型检测 · 角点提取</p></li>
        <li class="step"><span class="step-num">02</span><h3>几何</h3><p>PnP 单目测距 · 坐标变换 · 相机标定</p></li>
        <li class="step"><span class="step-num">03</span><h3>估计</h3><p>数据关联 · 整车 EKF 跟踪 · 车心诊断</p></li>
        <li class="step"><span class="step-num">04</span><h3>控制</h3><p>直瞄解算 · 控制时序 · 新鲜度门限</p></li>
        <li class="step"><span class="step-num">05</span><h3>通信</h3><p>RoboLink · USB CDC · 云台姿态反馈</p></li>
      </ol>
    </div>
  </section>

  <section class="band band--white" transition:name="projects-stage">
    <div class="container">
    <div class="section-head" data-reveal="focus">
      <p class="eyebrow"><span class="sec-num">01</span>PROJECTS</p>
      <h2><span class="grad">项目</span></h2>
      <a class="more" href="/projects/">全部项目 <span aria-hidden="true">›</span></a>
    </div>
    <div class="proj-grid" data-reveal-group>
      <article class="proj-card" transition:name="proj-rmav">
        <p class="eyebrow">2026.04 开始学视觉 · 暑假集中推进</p>
        <h3><a href="/projects/rm-armor-vision/">rm-armor-vision · 装甲板视觉识别全链路</a></h3>
        <p>
          学习视觉时仍在方程式车队，暑假白天主要在车间，晚上或不忙的几天抽空推进。从数据集到测距走通:YOLO26-pose 从随机初始化训练 → ONNX 导出 → C++ 手写推理管线(letterbox / 8400 解码 / IoU / NMS)
          → ROS2 节点 → 相机标定 → PnP 单目测距。仓库含演示 GIF、训练曲线与构建说明。
        </p>
        <div class="metrics">
          <div class="metric"><span class="num">0.842</span><span class="label">框 mAP50</span></div>
          <div class="metric"><span class="num">0.675</span><span class="label">角点 mAP50</span></div>
          <div class="metric"><span class="num">0.48<small>px</small></span><span class="label">标定误差</span></div>
        </div>
        <div class="links">
          <a href="/projects/rm-armor-vision/">查看详情 <span aria-hidden="true">›</span></a>
          <a href="https://github.com/taozibb23/rm-armor-vision" target="_blank" rel="noopener">GitHub →</a>
        </div>
      </article>
      <article class="proj-card">
        <p class="eyebrow">团队 · RoboMaster 战队视觉 · 项目推进中</p>
        <h3>战队视觉系统 · 我负责整体推进</h3>
        <p>
          从视觉前端、PnP 几何、目标跟踪，到控制时序和 RoboLink 通信，我负责串起系统路线、接口与分阶段验证。真实图像到云台姿态响应的受限台架通路已有记录；几何漂移、动态响应、手眼绝对精度与命中仍待验收。机械臂视觉抓取已启动接口与几何原型，尚非实机抓取。
        </p>
        <div class="links">
          <a href="/projects/foray-team/">查看详情 <span aria-hidden="true">›</span></a>
          <a href="/projects/arm-vision/">机械臂进度 →</a>
          <a href="https://github.com/ZQU-Foray/foray_vision" target="_blank" rel="noopener">foray_vision →</a>
          <a href="https://github.com/ZQU-Foray/foray_auto_aim" target="_blank" rel="noopener">foray_auto_aim →</a>
        </div>
      </article>
    </div>
    </div>
  </section>

  <section class="band band--gray" transition:name="blog-stage">
    <div class="container">
    <div class="section-head" data-reveal="focus">
      <p class="eyebrow"><span class="sec-num">02</span>BLOG</p>
      <h2><span class="grad">最新文章</span></h2>
      <a class="more" href="/blog/">全部 {posts.length} 篇 <span aria-hidden="true">›</span></a>
    </div>
    </div>
    <div class="scroller" data-scroller>
      <div class="scroller-track">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
    <div class="scroller-nav container">
      <button class="scroller-btn" data-sc-prev aria-label="上一张">‹</button>
      <button class="scroller-btn" data-sc-next aria-label="下一张">›</button>
    </div>
  </section>

  <section class="band band--white">
    <div class="container">
      <div class="section-head" data-reveal="focus">
        <p class="eyebrow"><span class="sec-num">03</span>WORKBENCH</p>
        <h2><span class="grad">工作台</span></h2>
        <a class="more" href="/workbench/">进去看看 <span aria-hidden="true">›</span></a>
      </div>
      <div class="bench-strip" data-reveal-group>
        <a class="bench-mini" href="/workbench/">
          <img src="/images/workbench/cad-01.svg" alt="零件轮廓练习线稿" loading="lazy" />
          <div class="t">
            <strong>工程图练习</strong>
            <span>零件轮廓与三视图,从 DXF 矢量数据原样描线</span>
          </div>
        </a>
        <a class="bench-mini" href="/workbench/">
          <img src="/images/workbench/pcb2d-stm32.png" alt="STM32 开发板布线图缩略" loading="lazy" />
          <div class="t">
            <strong>硬件与建模 · 已收坑</strong>
            <span>方程式车架 3D(可点选杆件)· 蓝色板底 PCB 3D · 三块板从立创EDA 到 gerber</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="band band--gray cta-band">
    <div class="container" data-reveal="focus">
      <p class="eyebrow">NEXT · 下一步</p>
      <h2>想看现在做到哪了？</h2>
      <p class="sub">带日期的进度快照，区分已测、候选与未完成——不把不同证据等级混成“系统已完成”。</p>
      <div class="hero-cta">
        <a class="btn-primary" href="/status/">查看当前进度</a>
        <a class="link-more" href="/about/">关于我 <span aria-hidden="true">›</span></a>
      </div>
    </div>
  </section>
<script>
  // 画廊箭头:按卡宽步进滚动;端点自动禁用
  function bindScroller() {
    const sc = document.querySelector('[data-scroller]');
    if (!sc || sc.dataset.scBound) return;
    sc.dataset.scBound = '1';
    const track = sc.querySelector('.scroller-track');
    const prev = document.querySelector('[data-sc-prev]');
    const next = document.querySelector('[data-sc-next]');
    const step = () => {
      const card = track && track.querySelector('.post-card');
      if (!card) return 400;
      const gap = parseFloat(getComputedStyle(track).gap || '24') || 24;
      return card.offsetWidth + gap;
    };
    // 自定义缓动滚动(强 ease-out,比浏览器 smooth 更丝滑可控)
    const easeOut = (t) => 1 - Math.pow(1 - t, 4);
    let glideRAF = 0;
    const glideTo = (target, dur = 520) => {
      cancelAnimationFrame(glideRAF);
      const max = sc.scrollWidth - sc.clientWidth;
      target = Math.max(0, Math.min(target, max));
      const from = sc.scrollLeft, delta = target - from;
      sc.style.scrollSnapType = 'none';
      if (Math.abs(delta) < 1) { sc.style.scrollSnapType = ''; return; }
      const t0 = performance.now();
      const frame = (now) => {
        const t = Math.min(1, (now - t0) / dur);
        sc.scrollLeft = from + delta * easeOut(t);
        if (t < 1) glideRAF = requestAnimationFrame(frame);
        else sc.style.scrollSnapType = '';
      };
      glideRAF = requestAnimationFrame(frame);
    };
    prev?.addEventListener('click', () => glideTo(sc.scrollLeft - step()));
    next?.addEventListener('click', () => glideTo(sc.scrollLeft + step()));
    const update = () => {
      const max = sc.scrollWidth - sc.clientWidth - 1;
      if (prev) prev.disabled = sc.scrollLeft <= 1;
      if (next) next.disabled = sc.scrollLeft >= max;
    };
    sc.addEventListener('scroll', update, { passive: true });
    update();

    // 鼠标拖动:跟手 1:1 + 松手惯性滑行 + 缓动吸附最近卡(触屏走原生惯性)
    let down = false, sx = 0, sl = 0, movedPx = 0;
    let lastX = 0, lastT = 0, vel = 0, momentumRAF = 0;
    sc.addEventListener('dragstart', (e) => e.preventDefault());
    sc.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch') return;
      down = true; movedPx = 0; vel = 0;
      sx = e.clientX; sl = sc.scrollLeft;
      lastX = e.clientX; lastT = performance.now();
      cancelAnimationFrame(momentumRAF); cancelAnimationFrame(glideRAF);
      sc.style.scrollSnapType = 'none';
      sc.classList.add('dragging');
    });
    window.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - sx;
      movedPx = Math.max(movedPx, Math.abs(dx));
      sc.scrollLeft = sl - dx;
      const now = performance.now();
      const dt = now - lastT;
      if (dt > 0) {
        const inst = (lastX - e.clientX) / dt; // px/ms
        vel = Math.max(-2.5, Math.min(2.5, vel * 0.7 + inst * 0.3));
        lastX = e.clientX; lastT = now;
      }
    });
    const snapStep = () => {
      const card = sc.querySelector('.post-card');
      const gap = parseFloat(getComputedStyle(sc.querySelector('.scroller-track')).gap || '24') || 24;
      return card ? card.offsetWidth + gap : 400;
    };
    const settle = () => {
      if (!down) return;
      down = false;
      sc.classList.remove('dragging');
      const st = snapStep();
      const snap = () => glideTo(Math.round(sc.scrollLeft / st) * st, 480);
      if (Math.abs(vel) > 0.08) {
        // 惯性滑行:速度按帧率无关衰减,停下后吸附
        let prevT = performance.now();
        const decay = (now) => {
          const dt = Math.min(now - prevT, 40); prevT = now;
          vel *= Math.pow(0.9, dt / 16);
          if (Math.abs(vel) < 0.02) { snap(); return; }
          sc.scrollLeft += vel * dt;
          momentumRAF = requestAnimationFrame(decay);
        };
        momentumRAF = requestAnimationFrame(decay);
      } else snap();
    };
    window.addEventListener('pointerup', settle);
    window.addEventListener('pointercancel', settle);
    sc.addEventListener(
      'click',
      (e) => {
        if (movedPx > 6) {
          e.preventDefault();
          e.stopPropagation();
          movedPx = 0;
        }
      },
      true
    );
  }
  bindScroller();
  document.addEventListener('astro:page-load', bindScroller);
</script>
</Base>
